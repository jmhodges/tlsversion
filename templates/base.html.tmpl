<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ block "title" . }}tlsversion.com{{ end }}</title>
<style>
:root {
  --paper: #faf8f3;
  --ink:   #221e18;
  --muted: #47423a;
  --rule:  #e4ddcd;
  --link:  #2f5d50;

  --serif: Tahoma;
  --mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
  --measure: 34rem;
}

@media (prefers-color-scheme: dark) {
  :root {
    --paper: #16140f;
    --ink:   #ece3d3;
    --muted: #b0a692;
    --rule:  #2f2a21;
    --link:  #7cb3a1;   /* lifted sage — forest goes muddy on dark paper */
  }
}

*,
*::before,
*::after { box-sizing: border-box; }

html { -webkit-text-size-adjust: 100%; }

body {
  margin: 0;
  background: var(--paper);
  color: var(--ink);
  font: 1.25rem/1.65 var(--serif);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

main {
  width: 100%;
  max-width: var(--measure);
  margin: 0 auto;
  padding: 4rem 1.5rem 1.5rem;
}

main > * + * { margin-top: 1.2rem; }

a {
  color: var(--link);
  text-underline-offset: 2px;
  text-decoration-thickness: 1px;
}
a:hover { text-decoration: none; }

/* The home page's framing line: "Your connection negotiated" */
.kicker {
  margin: 0;
  font-size: 1.05rem;
  font-variant: small-caps;
  letter-spacing: 0.02em;
  color: var(--muted);
}

/* The TLS version itself, set as display type rather than boxed. */
.version {
  margin: 0;
  font-size: clamp(4.5rem, 24vw, 9rem);
  line-height: 1.0;
  letter-spacing: -0.02em;
  font-feature-settings: "lnum" 1;
}

.note { color: var(--muted); }

h1 {
  margin: 0;
  font-size: 1.7rem;
  font-weight: 600;
}

/* Section heads echo the home page's kicker: small-caps labels that
   sit below the h1 rather than competing with it. */
h2 {
  margin: 2.6rem 0 0;
  font-size: 1.05rem;
  font-weight: 600;
  font-variant: small-caps;
  letter-spacing: 0.04em;
  color: var(--muted);
}

.toc ol {
  margin: 0;
  padding-left: 1.5rem;
  font-size: 1.05rem;
}

.toc li::marker { color: var(--muted); }

code {
  font: 0.85em var(--mono);
  background: var(--rule);
  background: color-mix(in srgb, var(--rule) 55%, transparent);
  padding: 0.05em 0.3em;
  border-radius: 3px;
}

pre {
  margin: 0;
  padding: 1rem 1.25rem;
  font: 0.85em/1.6 var(--mono);
  background: color-mix(in srgb, var(--rule) 45%, transparent);
  border: 1px solid var(--rule);
  border-radius: 6px;
  overflow-x: auto;
}

footer {
  width: 100%;
  max-width: var(--measure);
  margin: 0 auto;
  padding: 1.2rem 1.5rem 2.5rem;
  border-top: 1px solid var(--rule);
  font-size: 1.1rem;
  color: var(--muted);
}

footer a { color: var(--muted); }
footer a:hover { color: var(--link); }
</style>
</head>
<body>
<main>
{{ block "content" . }}{{ end }}
</main>
<footer>
<a href="/">Home</a> &middot;
<a href="/about">About</a> &middot;
<a href="/v1/version.json">JSON API</a> &middot;
<a href="https://github.com/jmhodges/tlsversion">Source</a>
</footer>
</body>
</html>
