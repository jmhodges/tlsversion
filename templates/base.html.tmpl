<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ block "title" . }}tlsversion.com{{ end }}</title>
<style>
:root {
  --paper: #faf8f3;
  --ink:   #221e18;
  --muted: #47423a;
  --rule:  #e4ddcd;
  --link:  #2f5d50;

  --serif: Tahoma;
  --mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
  --measure: 39rem;

  /* Gradient frame behind the paper card: pale sage sweeping through
     a warm grey into a cool teal, top-left to bottom-right. It echoes
     the sage of --link without competing with the paper. */
  --frame-warm: #e2eedd;
  --frame-mid:  #edeae3;
  --frame-cool: #d8ebe4;
}

@media (prefers-color-scheme: dark) {
  :root {
    --paper: #16140f;
    --ink:   #ece3d3;
    --muted: #b0a692;
    --rule:  #2f2a21;
    --link:  #7cb3a1;   /* lifted sage — forest goes muddy on dark paper */

    --frame-warm: #1e2619;
    --frame-mid:  #1e1c17;
    --frame-cool: #17241f;
  }
}

*,
*::before,
*::after { box-sizing: border-box; }

html {
  -webkit-text-size-adjust: 100%;
  /* Without a viewport-filling box, short pages would repeat the gradient
     below the card with a visible seam. */
  min-height: 100%;
  background: var(--frame-mid);
  background: linear-gradient(135deg,
    var(--frame-warm) 0%,
    var(--frame-mid) 35%,
    var(--frame-cool) 100%);
}

/* The KOReader trick: the page background is a gradient, and the body is
   a paper card narrower than the viewport that hangs from the top edge,
   so the gradient frames it on the sides and below. */
body {
  margin: 0 auto 1.5rem;
  max-width: calc(var(--measure) + 2.5rem);
  background: var(--paper);
  border: 10px solid var(--rule);
  border-top: none;
  /* All four corners round: the top pair curls the card's shoulders away
     from the viewport edge so the gradient peeks through up there too. */
  border-radius: 2em;
  color: var(--ink);
  font: 1.25rem/1.65 var(--serif);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

main {
  width: 100%;
  max-width: var(--measure);
  margin: 0 auto;
  padding: 4rem 1.5rem 1.5rem;
}

main > * + * { margin-top: 1.65rem; }

a {
  color: var(--link);
  text-underline-offset: 2px;
  text-decoration-thickness: 1px;
}
a:hover { text-decoration: none; }

/* The home page's framing line: "Your connection negotiated" */
.kicker {
  margin: 0;
  font-size: 1.05rem;
  font-variant: small-caps;
  letter-spacing: 0.02em;
  color: var(--muted);
}

/* The TLS version itself, set as display type rather than boxed. */
.version {
  margin: 0;
  font-size: clamp(4.5rem, 24vw, 9rem);
  line-height: 1.0;
  letter-spacing: -0.02em;
  font-feature-settings: "lnum" 1;
}

.note { color: var(--muted); }

h1 {
  margin: 0;
  font-size: 1.7rem;
  font-weight: 600;
}

/* Section heads echo the home page's kicker: small-caps labels that
   sit below the h1 rather than competing with it. */
h2 {
  margin: 3.5rem 0 0;
  font-size: 1.05rem;
  font-weight: 600;
  font-variant: small-caps;
  letter-spacing: 0.04em;
  color: var(--muted);
}

h2[id] {
  position: relative;
  scroll-margin-top: 1rem;
}

.anchor-link {
  position: absolute;
  right: 100%;
  padding-right: 0.35em;
  color: var(--muted);
  text-decoration: none;
  opacity: 0;
  transition: opacity 0.15s;
}

.anchor-link:focus-visible { opacity: 1; }

@media (hover: hover) {
  h2[id]:hover .anchor-link { opacity: 1; }
}

.toc { margin-top: 2rem; }

.toc ol {
  margin: 0;
  padding-left: 1.5rem;
  font-size: 1.05rem;
}

.toc li::marker { color: var(--muted); }

code {
  font: 0.85em var(--mono);
  background: var(--rule);
  background: color-mix(in srgb, var(--rule) 55%, transparent);
  padding: 0.05em 0.3em;
  border-radius: 3px;
}

pre {
  margin: 0;
  padding: 1rem 1.25rem;
  font: 0.85em/1.6 var(--mono);
  background: color-mix(in srgb, var(--rule) 45%, transparent);
  border: 1px solid var(--rule);
  border-radius: 6px;
  overflow-x: auto;
}

footer {
  width: 100%;
  max-width: var(--measure);
  margin: 0 auto;
  padding: 1.2rem 1.5rem 2.5rem;
  border-top: 1px solid var(--rule);
  font-size: 1.1rem;
  color: var(--muted);
}

footer a { color: var(--muted); }
footer a:hover { color: var(--link); }
</style>
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-CN0VBSZDNY"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-CN0VBSZDNY');
</script>
</head>
<body>
<main>
{{ block "content" . }}{{ end }}
</main>
<footer>
<a href="/">Home</a> &middot;
<a href="/about">About</a> &middot;
<a href="/about#json-api">JSON API</a> &middot;
<a href="https://github.com/jmhodges/tlsversion">Source</a>
</footer>
</body>
</html>
